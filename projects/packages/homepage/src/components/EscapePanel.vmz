<template>
  <div class="escape">
  <Space direction="vertical" size="large">
    <Space wrap size="middle" class="toolbar">
      <Field
        label="Family"
        :value="family"
        description="WASM samples the field; TypeScript paints ImageData."
        @input="onFamilyInput"
      />
      <Field
        label="Max iter"
        type="number"
        min="20"
        max="240"
        step="10"
        :value="maxIterText"
        @input="onMaxIterInput"
      />
      <Field
        label="Scale"
        type="number"
        min="0.5"
        max="4"
        step="0.1"
        :value="scaleText"
        @input="onScaleInput"
      />
      <Space wrap size="small" class="actions">
        <Button type="button" @click="redraw">Redraw</Button>
        <Button type="button" variant="ghost" @click="reset">Reset</Button>
      </Space>
    </Space>

    <Callout :tone="calloutTone" :title="calloutTitle" :description="status" />

    <canvas
      class="canvas"
      width="480"
      height="300"
      role="img"
      aria-label="Escape-time fractal field"
    ></canvas>

    <Typography variant="secondary">
      {{ family }} · {{ width }}×{{ height }} · maxIter {{ maxIter }}
    </Typography>
  </Space>
  </div>
</template>

<style>
.toolbar {
  align-items: flex-end;
  width: 100%;
}
.actions {
  align-items: center;
  padding-bottom: 0.15rem;
}
.canvas {
  display: block;
  height: auto;
}
</style>

<script client>
type EscapeField = {
  width: number;
  height: number;
  maxIter: number;
  values: number[] | Uint16Array;
};

type WasmModule = {
  default: (input?: RequestInfo | URL | Response | BufferSource | WebAssembly.Module) => Promise<unknown>;
  mandelbrot: (
    width: number,
    height: number,
    centerX: number,
    centerY: number,
    scale: number,
    maxIter: number,
  ) => EscapeField;
  julia: (
    width: number,
    height: number,
    centerX: number,
    centerY: number,
    scale: number,
    cx: number,
    cy: number,
    maxIter: number,
  ) => EscapeField;
};

function hslToRgb(h: number, s: number, l: number): { r: number; g: number; b: number } {
  const hue = ((h % 360) + 360) % 360;
  const c = (1 - Math.abs(2 * l - 1)) * s;
  const x = c * (1 - Math.abs(((hue / 60) % 2) - 1));
  const m = l - c / 2;
  let rp = 0;
  let gp = 0;
  let bp = 0;
  if (hue < 60) {
    rp = c;
    gp = x;
  } else if (hue < 120) {
    rp = x;
    gp = c;
  } else if (hue < 180) {
    gp = c;
    bp = x;
  } else if (hue < 240) {
    gp = x;
    bp = c;
  } else if (hue < 300) {
    rp = x;
    bp = c;
  } else {
    rp = c;
    bp = x;
  }
  return {
    r: Math.round((rp + m) * 255),
    g: Math.round((gp + m) * 255),
    b: Math.round((bp + m) * 255),
  };
}

/** TS render: map escape iterations → ImageData (no color bake-in from Rust). */
function paintEscapeField(
  canvas: HTMLCanvasElement,
  field: EscapeField,
  options: { hue?: number; interiorRgb?: [number, number, number] } = {},
) {
  const ctx = canvas.getContext("2d");
  if (!ctx) throw new Error("2D canvas context unavailable");
  const width = field.width | 0;
  const height = field.height | 0;
  canvas.width = width;
  canvas.height = height;
  const image = ctx.createImageData(width, height);
  const data = image.data;
  const maxIter = Math.max(field.maxIter, 1);
  const hue = options.hue ?? 210;
  const [ir, ig, ib] = options.interiorRgb ?? [8, 8, 16];
  for (let i = 0; i < width * height; i++) {
    const iter = field.values[i] ?? 0;
    const o = i * 4;
    if (iter >= maxIter) {
      data[o] = ir;
      data[o + 1] = ig;
      data[o + 2] = ib;
      data[o + 3] = 255;
      continue;
    }
    const t = iter / maxIter;
    const { r, g, b } = hslToRgb(hue, 0.72, 0.12 + t * 0.62);
    data[o] = r;
    data[o + 1] = g;
    data[o + 2] = b;
    data[o + 3] = 255;
  }
  ctx.putImageData(image, 0, 0);
}

let wasmReady: Promise<WasmModule> | null = null;

function loadWasm(): Promise<WasmModule> {
  if (!wasmReady) {
    wasmReady = import("/wasm/fractal_wasm.js").then(async (mod: WasmModule) => {
      await mod.default("/wasm/fractal_wasm_bg.wasm");
      return mod;
    });
  }
  return wasmReady;
}

export default class EscapePanel {
  family = "mandelbrot";
  width = 480;
  height = 300;
  maxIter = 80;
  maxIterText = "80";
  scale = 3;
  scaleText = "3";
  status = "Loading WASM escape engine…";
  busy = false;
  calloutTone = "info";
  calloutTitle = "Status";

  constructor() {
    void this.draw();
  }

  async draw() {
    if (this.busy) return;
    this.busy = true;
    this.calloutTone = "info";
    this.calloutTitle = "Sampling";
    this.status = "WASM fills the iteration field; TypeScript paints pixels…";
    try {
      const wasm = await loadWasm();
      const field =
        this.family === "julia"
          ? wasm.julia(this.width, this.height, 0, 0, this.scale, -0.8, 0.156, this.maxIter)
          : wasm.mandelbrot(this.width, this.height, -0.5, 0, this.scale, this.maxIter);
      const canvas = document.querySelector(".escape canvas.canvas") as HTMLCanvasElement | null;
      if (canvas) {
        paintEscapeField(canvas, field, { hue: this.family === "julia" ? 300 : 210 });
      }
      this.calloutTone = "success";
      this.calloutTitle = `${this.family} · ${this.width}×${this.height}`;
      this.status = "Geometry from Rust WASM · color from TypeScript ImageData.";
    } catch (err) {
      this.calloutTone = "danger";
      this.calloutTitle = "Render failed";
      this.status = err instanceof Error ? err.message : String(err);
    } finally {
      this.busy = false;
    }
  }

  onFamilyInput(event: Event) {
    const target = event.target as HTMLInputElement | null;
    if (!target) return;
    const next = target.value.trim().toLowerCase();
    if (next !== "mandelbrot" && next !== "julia") return;
    this.family = next;
    void this.draw();
  }

  onMaxIterInput(event: Event) {
    const target = event.target as HTMLInputElement | null;
    if (!target) return;
    const next = Number.parseInt(target.value, 10);
    if (!Number.isFinite(next) || next < 20 || next > 240) return;
    this.maxIter = next;
    this.maxIterText = String(next);
    void this.draw();
  }

  onScaleInput(event: Event) {
    const target = event.target as HTMLInputElement | null;
    if (!target) return;
    const next = Number.parseFloat(target.value);
    if (!Number.isFinite(next) || next < 0.5 || next > 4) return;
    this.scale = next;
    this.scaleText = String(next);
    void this.draw();
  }

  redraw() {
    void this.draw();
  }

  reset() {
    this.family = "mandelbrot";
    this.maxIter = 80;
    this.maxIterText = "80";
    this.scale = 3;
    this.scaleText = "3";
    void this.draw();
  }
}
</script>
