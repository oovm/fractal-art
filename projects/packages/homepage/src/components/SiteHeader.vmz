<template>
  <header class="site-header">
    <div class="site-header__inner">
      <Link to="IndexPage" class="site-brand" aria-label="Fractal home">
        <span class="site-brand__mark">Fractal</span>
        <span class="site-brand__tag">Art</span>
      </Link>

      <nav class="site-nav" aria-label="Primary">
        <Link to="IndexPage" :aria-current="homeCurrent">Home</Link>
        <Link to="WelcomePage" :aria-current="welcomeCurrent">Welcome</Link>
        <a href="/welcome#studios" data-vmz-route="WelcomePage" :aria-current="studiosCurrent">Studios</a>
      </nav>

      <code class="site-header__pkg">@doki-land/fractal</code>
    </div>
  </header>
</template>

<script client>
const STUDIO_PREFIXES = [
  "/turtle",
  "/fern",
  "/sierpinski",
  "/attractor",
  "/mandelbrot",
  "/julia",
  "/lyapunov",
  "/melody",
];

export default class SiteHeader {
  homeCurrent: string | null = null;
  welcomeCurrent: string | null = null;
  studiosCurrent: string | null = null;

  onMount() {
    this.syncNav();
  }

  syncNav() {
    const pathname =
      typeof window !== "undefined" && window.location && typeof window.location.pathname === "string"
        ? window.location.pathname
        : "";
    if (!pathname) return;
    const path = pathname.replace(/\/$/, "") || "/";
    this.homeCurrent = path === "/" ? "page" : null;
    this.welcomeCurrent = path === "/welcome" ? "page" : null;
    this.studiosCurrent = STUDIO_PREFIXES.some((prefix) => path === prefix || path.startsWith(`${prefix}/`))
      ? "page"
      : null;
  }
}
</script>
