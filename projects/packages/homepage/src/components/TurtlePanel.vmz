<template>
  <section class="turtle">
    <div class="toolbar">
      <label>
        Iterations
        <input type="number" min="1" max="5" :value="iterations" @input="onIterInput" />
      </label>
      <Button type="button" @click="grow">Grow</Button>
      <Button type="button" variant="ghost" @click="reset">Reset</Button>
    </div>
    <p class="status">{{ status }}</p>
    <svg class="canvas" :viewBox="viewBox" role="img" aria-label="L-system turtle path">
      <polyline class="stroke" fill="none" :points="polyline" />
    </svg>
    <p class="meta">String length: {{ sourceLength }}</p>
  </section>
</template>

<style>
.toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  align-items: end;
  margin-bottom: 1rem;
}
.canvas {
  display: block;
  width: min(100%, 28rem);
  height: 18rem;
  border: 1px solid #d1d5db;
  border-radius: 8px;
  background: #f9fafb;
}
.stroke {
  stroke: #166534;
  stroke-width: 1.2;
  stroke-linejoin: round;
  stroke-linecap: round;
}
.status,
.meta {
  font-size: 0.875rem;
  color: #4b5563;
}
</style>

<script client>
type GrowResult = {
  points: string;
  viewBox: string;
  source: string;
  sourceLength: number;
};

type WasmModule = {
  default: (input?: RequestInfo | URL | Response | BufferSource | WebAssembly.Module) => Promise<unknown>;
  growPlant: (iterations: number, step: number, turnDegrees: number, padding: number) => GrowResult;
};

let wasmReady: Promise<WasmModule> | null = null;

function loadWasm(): Promise<WasmModule> {
  if (!wasmReady) {
    wasmReady = import("/wasm/fractal_wasm.js").then(async (mod: WasmModule) => {
      await mod.default("/wasm/fractal_wasm_bg.wasm");
      return mod;
    });
  }
  return wasmReady;
}

export default class TurtlePanel {
  iterations = 3;
  polyline = "";
  viewBox = "0 0 100 100";
  status = "Loading WASM plant engine…";
  sourceLength = 0;
  busy = false;

  constructor() {
    void this.draw();
  }

  async draw() {
    if (this.busy) return;
    this.busy = true;
    try {
      const wasm = await loadWasm();
      const result = wasm.growPlant(this.iterations, 8, 25, 16);
      this.polyline = result.points;
      this.viewBox = result.viewBox;
      this.sourceLength = result.sourceLength;
      this.status = `Generation ${this.iterations} via fractal WASM (browser).`;
    } catch (err) {
      this.status = `WASM load failed: ${err instanceof Error ? err.message : String(err)}`;
    } finally {
      this.busy = false;
    }
  }

  onIterInput(event: Event) {
    const target = event.target as HTMLInputElement | null;
    if (!target) return;
    const next = Number.parseInt(target.value, 10);
    if (!Number.isFinite(next) || next < 1 || next > 5) return;
    this.iterations = next;
    void this.draw();
  }

  grow() {
    if (this.iterations < 5) {
      this.iterations += 1;
    }
    void this.draw();
  }

  reset() {
    this.iterations = 1;
    void this.draw();
  }
}
</script>
