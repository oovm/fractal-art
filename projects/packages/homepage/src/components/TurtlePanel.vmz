<template>
  <Space direction="vertical" size="large" class="turtle">
    <Space wrap size="middle" class="toolbar">
      <Field
        label="Iterations"
        type="number"
        min="1"
        max="5"
        :value="iterationsText"
        description="1–5 generations. WASM computes the path; TypeScript paints the canvas."
        @input="onIterInput"
      />
      <Space wrap size="small" class="actions">
        <Button type="button" @click="grow">Grow</Button>
        <Button type="button" variant="ghost" @click="reset">Reset</Button>
      </Space>
    </Space>

    <Callout :tone="calloutTone" :title="calloutTitle" :description="status" />

    <canvas
      class="canvas"
      width="720"
      height="440"
      role="img"
      aria-label="L-system turtle path"
    ></canvas>

    <Typography variant="secondary">
      Points: {{ pointCount }} · String length: {{ sourceLength }}
    </Typography>
  </Space>
</template>

<style>
.toolbar {
  align-items: flex-end;
  width: 100%;
}
.actions {
  align-items: center;
  padding-bottom: 0.15rem;
}
.canvas {
  display: block;
  width: min(100%, 36rem);
  height: auto;
  border: 1px solid var(--vmz-line-default);
  border-radius: var(--vmz-radius-lg, 8px);
  background: var(--vmz-surface-mist, #f5f5f5);
}
</style>

<script client>
type Point2 = { x: number; y: number };

type PlantPath = {
  points: Point2[];
  source: string;
  sourceLength: number;
};

type WasmModule = {
  default: (input?: RequestInfo | URL | Response | BufferSource | WebAssembly.Module) => Promise<unknown>;
  growPlant: (iterations: number, step: number, turnDegrees: number) => PlantPath;
};

type FitBounds = { minX: number; minY: number; width: number; height: number };

/** TS render: fit turtle points into a padded view. */
function fitBounds(points: Point2[], padding = 16): FitBounds {
  if (points.length === 0) {
    return { minX: 0, minY: 0, width: 100, height: 100 };
  }
  let minX = points[0].x;
  let minY = points[0].y;
  let maxX = points[0].x;
  let maxY = points[0].y;
  for (const p of points) {
    if (p.x < minX) minX = p.x;
    if (p.y < minY) minY = p.y;
    if (p.x > maxX) maxX = p.x;
    if (p.y > maxY) maxY = p.y;
  }
  return {
    minX: minX - padding,
    minY: minY - padding,
    width: Math.max(maxX - minX, 1) + padding * 2,
    height: Math.max(maxY - minY, 1) + padding * 2,
  };
}

/** TS render: stroke turtle geometry onto a canvas. */
function strokeCanvas(
  canvas: HTMLCanvasElement,
  points: Point2[],
  options: { padding?: number; strokeStyle?: string; lineWidth?: number; background?: string } = {},
) {
  const padding = options.padding ?? 16;
  const ctx = canvas.getContext("2d");
  if (!ctx) throw new Error("2D canvas context unavailable");
  const width = canvas.width;
  const height = canvas.height;
  ctx.clearRect(0, 0, width, height);
  if (options.background) {
    ctx.fillStyle = options.background;
    ctx.fillRect(0, 0, width, height);
  }
  if (points.length < 2) return;

  const box = fitBounds(points, padding);
  const scale = Math.min(width / box.width, height / box.height);
  const ox = (width - box.width * scale) / 2;
  const oy = (height - box.height * scale) / 2;

  ctx.beginPath();
  ctx.strokeStyle = options.strokeStyle ?? (getComputedStyle(canvas).getPropertyValue("--vmz-status-success-accent").trim() || "#52c41a");
  ctx.lineWidth = options.lineWidth ?? 2.4;
  ctx.lineJoin = "round";
  ctx.lineCap = "round";
  for (let i = 0; i < points.length; i++) {
    const x = ox + (points[i].x - box.minX) * scale;
    const y = oy + (points[i].y - box.minY) * scale;
    if (i === 0) ctx.moveTo(x, y);
    else ctx.lineTo(x, y);
  }
  ctx.stroke();
}

let wasmReady: Promise<WasmModule> | null = null;

function loadWasm(): Promise<WasmModule> {
  if (!wasmReady) {
    wasmReady = import("/wasm/fractal_wasm.js").then(async (mod: WasmModule) => {
      await mod.default("/wasm/fractal_wasm_bg.wasm");
      return mod;
    });
  }
  return wasmReady;
}

export default class TurtlePanel {
  iterations = 3;
  iterationsText = "3";
  status = "Loading WASM plant engine…";
  sourceLength = 0;
  pointCount = 0;
  busy = false;
  calloutTone = "info";
  calloutTitle = "Status";

  constructor() {
    void this.draw();
  }

  paint(points: Point2[]) {
    const canvas = document.querySelector(".turtle canvas.canvas") as HTMLCanvasElement | null;
    if (!canvas) return;
    const mist = getComputedStyle(document.body).getPropertyValue("--vmz-surface-mist").trim() || "#f5f5f5";
    const stroke = getComputedStyle(document.body).getPropertyValue("--vmz-status-success-accent").trim() || "#52c41a";
    strokeCanvas(canvas, points, { padding: 16, background: mist, strokeStyle: stroke, lineWidth: 2.4 });
  }

  async draw() {
    if (this.busy) return;
    this.busy = true;
    this.calloutTone = "info";
    this.calloutTitle = "Growing";
    this.status = "WASM computes turtle points; TypeScript strokes the canvas…";
    try {
      const wasm = await loadWasm();
      const result = wasm.growPlant(this.iterations, 8, 25);
      this.sourceLength = result.sourceLength;
      this.pointCount = result.points.length;
      this.iterationsText = String(this.iterations);
      this.paint(result.points);
      this.calloutTone = "success";
      this.calloutTitle = `Generation ${this.iterations}`;
      this.status = "Geometry from Rust WASM · paint from TypeScript canvas.";
    } catch (err) {
      this.calloutTone = "danger";
      this.calloutTitle = "Render failed";
      this.status = err instanceof Error ? err.message : String(err);
    } finally {
      this.busy = false;
    }
  }

  onIterInput(event: Event) {
    const target = event.target as HTMLInputElement | null;
    if (!target) return;
    const next = Number.parseInt(target.value, 10);
    if (!Number.isFinite(next) || next < 1 || next > 5) return;
    this.iterations = next;
    this.iterationsText = String(next);
    void this.draw();
  }

  grow() {
    if (this.iterations < 5) {
      this.iterations += 1;
      this.iterationsText = String(this.iterations);
    }
    void this.draw();
  }

  reset() {
    this.iterations = 1;
    this.iterationsText = "1";
    void this.draw();
  }
}
</script>
