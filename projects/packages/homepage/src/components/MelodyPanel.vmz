<template>
  <div class="melody">
  <Space direction="vertical" size="large">
    <Space wrap size="middle" class="toolbar">
      <Field
        label="Iterations"
        type="number"
        min="1"
        max="5"
        :value="iterationsText"
        description="WASM builds note events; TypeScript plays them with Web Audio."
        @input="onIterInput"
      />
      <Field
        label="Tempo"
        type="number"
        min="60"
        max="180"
        step="10"
        :value="tempoText"
        @input="onTempoInput"
      />
      <Field
        label="Seed MIDI"
        type="number"
        min="48"
        max="72"
        :value="seedText"
        @input="onSeedInput"
      />
      <Space wrap size="small" class="actions">
        <Button type="button" @click="play">Play</Button>
        <Button type="button" @click="downloadMidi">Download MIDI</Button>
        <Button type="button" variant="ghost" @click="reset">Reset</Button>
      </Space>
    </Space>

    <Callout :tone="calloutTone" :title="calloutTitle" :description="status" />

    <Typography variant="secondary">
      Notes: {{ noteCount }} · Tempo: {{ tempo }} BPM · Root MIDI: {{ seedMidi }}
    </Typography>
  </Space>
  </div>
</template>

<style>
.toolbar {
  align-items: flex-end;
  width: 100%;
}
.actions {
  align-items: center;
  padding-bottom: 0.15rem;
}
</style>

<script client>
import { isFractalWasmReady, loadFractalWasm } from "../lib/fractal-wasm.ts";

type NoteEvent = {
  time: number;
  midi: number;
  duration: number;
  velocity: number;
};

type Melody = {
  events: NoteEvent[];
  count: number;
};


function midiToHz(midi: number): number {
  return 440 * 2 ** ((midi - 69) / 12);
}

/** TS playback: schedule oscillators from Rust note events (no PCM from WASM). */
async function playMelody(melody: Melody, gain = 0.18): Promise<void> {
  const AudioCtx =
    window.AudioContext ||
    (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
  if (!AudioCtx) throw new Error("Web Audio API unavailable");
  const ctx = new AudioCtx();
  const master = ctx.createGain();
  master.gain.value = gain;
  master.connect(ctx.destination);
  const t0 = ctx.currentTime + 0.05;
  let end = t0;
  for (const e of melody.events) {
    const start = t0 + Math.max(0, e.time);
    const dur = Math.max(0.02, e.duration);
    const stop = start + dur;
    end = Math.max(end, stop);
    const osc = ctx.createOscillator();
    const g = ctx.createGain();
    osc.type = "sine";
    osc.frequency.value = midiToHz(e.midi);
    const vel = Math.min(1, Math.max(0, e.velocity)) * gain;
    g.gain.setValueAtTime(0, start);
    g.gain.linearRampToValueAtTime(vel, start + 0.01);
    g.gain.exponentialRampToValueAtTime(0.0001, stop);
    osc.connect(g);
    g.connect(master);
    osc.start(start);
    osc.stop(stop + 0.02);
  }
  await new Promise((r) => setTimeout(r, Math.ceil((end - ctx.currentTime) * 1000) + 50));
  await ctx.close();
}

function writeVarLen(value: number, out: number[]): void {
  let buffer = value & 0x7f;
  while ((value >>= 7) > 0) {
    buffer <<= 8;
    buffer |= (value & 0x7f) | 0x80;
  }
  for (;;) {
    out.push(buffer & 0xff);
    if (buffer & 0x80) buffer >>= 8;
    else break;
  }
}

/** TS export: Standard MIDI File format 0 from Rust note events. */
function toMidiBytes(melody: Melody, tempoBpm = 120, ppq = 480): Uint8Array {
  const usPerQuarter = Math.round(60_000_000 / Math.max(1, tempoBpm));
  type MidiMsg = { tick: number; bytes: number[] };
  const msgs: MidiMsg[] = [];
  for (const e of melody.events) {
    const start = Math.max(0, Math.round((e.time * tempoBpm * ppq) / 60));
    const durTicks = Math.max(1, Math.round((e.duration * tempoBpm * ppq) / 60));
    const note = Math.min(127, Math.max(0, Math.round(e.midi)));
    const vel = Math.min(127, Math.max(1, Math.round(e.velocity * 127)));
    msgs.push({ tick: start, bytes: [0x90, note, vel] });
    msgs.push({ tick: start + durTicks, bytes: [0x80, note, 0] });
  }
  msgs.sort((a, b) => a.tick - b.tick || a.bytes[0] - b.bytes[0]);
  const track: number[] = [];
  track.push(0x00, 0xff, 0x51, 0x03, (usPerQuarter >> 16) & 0xff, (usPerQuarter >> 8) & 0xff, usPerQuarter & 0xff);
  let prev = 0;
  for (const m of msgs) {
    writeVarLen(m.tick - prev, track);
    track.push(...m.bytes);
    prev = m.tick;
  }
  track.push(0x00, 0xff, 0x2f, 0x00);
  const header = [
    0x4d, 0x54, 0x68, 0x64,
    0, 0, 0, 6,
    0, 0,
    0, 1,
    (ppq >> 8) & 0xff, ppq & 0xff,
    0x4d, 0x54, 0x72, 0x6b,
    (track.length >> 24) & 0xff, (track.length >> 16) & 0xff, (track.length >> 8) & 0xff, track.length & 0xff,
    ...track,
  ];
  return Uint8Array.from(header);
}


export default class MelodyPanel {
  iterations = 3;
  iterationsText = "3";
  tempo = 120;
  tempoText = "120";
  seedMidi = 60;
  seedText = "60";
  noteCount = 0;
  busy = false;
  status = "Ready. Click Play to sample WASM events and hear Web Audio.";
  calloutTone = "info";
  calloutTitle = "Status";

  async play() {
    if (this.busy) return;
    this.busy = true;
    this.calloutTone = "info";
    this.calloutTitle = "Playing";
    this.status = "WASM builds the score; TypeScript schedules oscillators…";
    try {
      const wasm = await loadFractalWasm();
      const melody = wasm.growMelody(this.iterations, this.tempo, this.seedMidi);
      this.noteCount = melody.count;
      await playMelody(melody);
      this.calloutTone = "success";
      this.calloutTitle = `Melody · ${melody.count} notes`;
      this.status = "Note events from Rust WASM · playback from TypeScript Web Audio.";
    } catch (err) {
      this.calloutTone = "danger";
      this.calloutTitle = "Playback failed";
      this.status = err instanceof Error ? err.message : String(err);
    } finally {
      this.busy = false;
    }
  }

  async downloadMidi() {
    if (this.busy) return;
    this.busy = true;
    this.calloutTone = "info";
    this.calloutTitle = "Exporting";
    this.status = "WASM builds events; TypeScript encodes SMF…";
    try {
      const wasm = await loadFractalWasm();
      const melody = wasm.growMelody(this.iterations, this.tempo, this.seedMidi);
      this.noteCount = melody.count;
      const bytes = toMidiBytes(melody, this.tempo);
      const blob = new Blob([bytes], { type: "audio/midi" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `fractal-melody-${this.iterations}-${this.tempo}.mid`;
      a.click();
      URL.revokeObjectURL(url);
      this.calloutTone = "success";
      this.calloutTitle = `MIDI · ${melody.count} notes · ${bytes.byteLength} bytes`;
      this.status = "Note events from Rust WASM · SMF from TypeScript toMidiBytes.";
    } catch (err) {
      this.calloutTone = "danger";
      this.calloutTitle = "Export failed";
      this.status = err instanceof Error ? err.message : String(err);
    } finally {
      this.busy = false;
    }
  }

  onIterInput(event: Event) {
    const target = event.target as HTMLInputElement | null;
    if (!target) return;
    const next = Number.parseInt(target.value, 10);
    if (!Number.isFinite(next) || next < 1 || next > 5) return;
    this.iterations = next;
    this.iterationsText = String(next);
  }

  onTempoInput(event: Event) {
    const target = event.target as HTMLInputElement | null;
    if (!target) return;
    const next = Number.parseInt(target.value, 10);
    if (!Number.isFinite(next) || next < 60 || next > 180) return;
    this.tempo = next;
    this.tempoText = String(next);
  }

  onSeedInput(event: Event) {
    const target = event.target as HTMLInputElement | null;
    if (!target) return;
    const next = Number.parseInt(target.value, 10);
    if (!Number.isFinite(next) || next < 48 || next > 72) return;
    this.seedMidi = next;
    this.seedText = String(next);
  }

  reset() {
    this.iterations = 3;
    this.iterationsText = "3";
    this.tempo = 120;
    this.tempoText = "120";
    this.seedMidi = 60;
    this.seedText = "60";
    this.noteCount = 0;
    this.calloutTone = "info";
    this.calloutTitle = "Status";
    this.status = "Ready. Click Play to sample WASM events and hear Web Audio.";
  }
}
</script>
