{
    "name": "@doki-land/fractal",
    "version": "0.0.0",
    "description": "Fractal / L-system engine — Node facade over @doki-land/fractal-<platform>",
    "type": "module",
    "license": "MPL-2.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/oovm/fractal-art.git"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": ["src"],
    "scripts": {
        "typecheck": "tsc --noEmit"
    },
    "optionalDependencies": {
        "@doki-land/fractal-darwin-arm64": "workspace:*",
        "@doki-land/fractal-darwin-x64": "workspace:*",
        "@doki-land/fractal-linux-arm64": "workspace:*",
        "@doki-land/fractal-linux-x64": "workspace:*",
        "@doki-land/fractal-win32-x64": "workspace:*"
    },
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "typescript": "^5.8.3"
    }
}
