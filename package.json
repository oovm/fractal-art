{
    "name": "fractal-art-workspace",
    "private": true,
    "packageManager": "pnpm@11.24.0",
    "scripts": {
        "build": "cargo build --release -p fractal",
        "build:rs": "cargo build --release -p fractal",
        "build:napi": "node scripts/build-napi.mjs",
        "build:wasm": "node scripts/build-wasm.mjs",
        "build:web": "pnpm build:wasm && pnpm --filter homepage build",
        "test": "pnpm test:rs && pnpm test:js",
        "test:rs": "cargo test --release -p fractal",
        "test:js": "pnpm build:napi && pnpm --filter @doki-land/fractal test",
        "test:web": "pnpm --filter homepage check",
        "fmt": "nifty format",
        "fmt:check": "nifty format --check",
        "fmt:rs": "cargo fmt --all",
        "dev:web": "pnpm --filter homepage dev",
        "deploy:web": "pnpm --filter homepage build && pnpm --filter homepage deploy:cf",
        "p": "git push && git push --tags --prune",
        "reset": "git reset Head~ --soft",
        "u": "nifty update",
        "bump": "nifty bump",
        "placeholder": "nifty publish --placeholder --dry-run",
        "placeholder:publish": "nifty publish --placeholder",
        "placeholder:trust": "nifty trust",
        "promote:latest": "node scripts/ci/promote-platform-latest.mjs",
        "publish": "nifty publish",
        "trust": "nifty trust"
    },
    "devDependencies": {
        "@doki-land/fractal": "workspace:*",
        "@doki-land/fractal-win32-x64": "workspace:*",
        "@doki-land/fractal-unknown-wasm32": "workspace:*",
        "@doki-land/nifty": "^0.0.11",
        "@napi-rs/cli": "^2.18.4"
    }
}
