# Copy to .env.placeholder.local (gitignored) for `pnpm placeholder:publish` / `pnpm trust`.
# NPM_TOTP_SECRET=<authenticator base32 secret>
# NPM_TOKEN=npm_xxx
#
# Trust contract (must match .cache/npm-placeholder.json trust_expect):
# NIFTY_TRUST_REPO=oovm/fractal-art
# NIFTY_TRUST_FILE=publish-npm.yml
# NIFTY_TRUST_ENV=NPM_PUBLISH
#
# Publish/trust cache: copy .cache/npm-placeholder.json.example to .cache/npm-placeholder.json
